# Prop Firm Lenz — environment contract.
# NAMES ONLY. Never commit real values (docs/INITIALIZATION.md §8, CLAUDE.md §6).

NODE_ENV=
NEXT_PUBLIC_SITE_URL=https://propfirmlenz.com

# Neon PostgreSQL — two endpoints, two purposes (docs/ARCHITECTURE.md §3.3)
DATABASE_URL=                 # POOLED  — application runtime
DATABASE_URL_DIRECT=          # DIRECT  — drizzle-kit migrations only

# Auth (docs/ARCHITECTURE.md §5.2)
AUTH_SESSION_PEPPER=          # session-token hashing pepper
IP_HASH_SALT=                 # salted IP/UA hashing — rotated

# Cloudflare R2 (docs/ARCHITECTURE.md §7)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=           # https://cdn.propfirmlenz.com

# Observability (docs/ARCHITECTURE.md §12)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=            # build-time only, source-map upload
LOG_LEVEL=info
